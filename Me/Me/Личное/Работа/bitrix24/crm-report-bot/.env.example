# Вебхук уже в Личное/Работа/bitrix24/.env → B24_TEST_WEBHOOK
# (подхватывается автоматически через lib/load-env.js)

# Опционально — только для бота:
B24_BOT_ID=
B24_BOT_TOKEN=crm_report_bot_tok
B24_BOT_CODE=crm_report_bot

# Публичный HTTPS (ngrok / cloudflared) — обязательно для register и handler
B24_HANDLER_URL=https://xxxx.ngrok-free.app/bitrix/handler
B24_HANDLER_PATH=/bitrix/handler

B24_DEAL_CATEGORY_ID=1
PORT=3847
